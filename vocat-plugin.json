{
  "schema_version": 1,
  "id": "vocat-sipserver",
  "name": "VoCat SIP Server",
  "version": "1.0.0",
  "description": "SIP/PBX server for VoCat - enables SIP clients (Zoiper, Groundwire) to make/receive calls and SMS via cellular modem",
  "author": "VoCat Team",
  "homepage": "https://github.com/MengMengCode/VoCat",
  "permissions": ["device:control", "sms:send", "call:manage", "network:access"],
  "contributions": [
    {
      "id": "dashboard",
      "label": "Voice Dashboard",
      "label_zh": "语音仪表",
      "location": "sidebar",
      "after": "devices",
      "icon": "dashboard",
      "entry": "index.html"
    },
    {
      "id": "accounts",
      "label": "Voice Accounts",
      "label_zh": "语音账户",
      "location": "sidebar",
      "after": "devices",
      "icon": "contacts",
      "entry": "accounts.html"
    },
    {
      "id": "settings",
      "label": "Voice Settings",
      "label_zh": "语音设置",
      "location": "sidebar",
      "after": "devices",
      "icon": "settings",
      "entry": "settings.html"
    },
    {
      "id": "call-log",
      "label": "Call Log",
      "label_zh": "通话记录",
      "location": "sidebar",
      "after": "devices",
      "icon": "history",
      "entry": "call-log.html"
    }
  ],
  "backend": {
    "commands": {
      "linux/amd64": "backend/vocat-sipserver-backend",
      "linux/arm64": "backend/vocat-sipserver-backend",
      "linux/386": "backend/vocat-sipserver-backend",
      "linux/aarch64": "backend/vocat-sipserver-backend",
      "linux/armv7": "backend/vocat-sipserver-backend"
    }
  }
}
